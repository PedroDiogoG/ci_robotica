<?xml version="1.0"?>
<robot name="hot_wheels">
  <!--  Base Link  -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0" />
      <mass value="5.0" />
      <inertia ixx="0.0135" iyy="0.0208" izz="0.026" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision name="collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.15 0.1" />
      </geometry>
    </collision>
    <visual name="visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.15 0.1" />
      </geometry>
    </visual>
  </link>
  <!-- Meshes  -->
  <link name="decorations_link">
    <visual name="hotwheels_logo_left">
      <origin xyz="-0.08 -0.015 0" rpy="-1.5708 3.1416 1.5708" />
      <geometry>
        <mesh filename="package://model_description/meshes/Hotwheels.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual name="hotwheels_logo_right">
      <origin xyz="0.08 -0.015 0" rpy="-1.5708 0 -1.5708" />
      <geometry>
        <mesh filename="package://model_description/meshes/Hotwheels.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
    <visual name="rubber_duck">
      <origin xyz="0 0 0.07" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://model_description/meshes/Rubber_Duck.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </visual>
  </link>
  <joint name="decorations_joint" type="fixed">
    <parent link="base_link" />
    <child link="decorations_link" />
    <origin xyz="0 0 0" rpy="0 0 -1.5708" />
  </joint>
  <!-- Caster Wheel -->
  <link name="caster_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <collision name="caster_wheel_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.025" />
      </geometry>
    </collision>
    <visual name="caster_wheel_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.025" />
      </geometry>
    </visual>
  </link>
  <!-- Left Wheel -->
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.00070" ixy="0.0" ixz="0.0" iyy="0.00070" iyz="0.0" izz="0.00125" />
    </inertial>
    <collision name="collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.03" />
      </geometry>
    </collision>
    <visual name="visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.03" />
      </geometry>
    </visual>
  </link>
  <!-- Right Wheel -->
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.00070" ixy="0.0" ixz="0.0" iyy="0.00070" iyz="0.0" izz="0.00125" />
    </inertial>
    <collision name="collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.03" />
      </geometry>
    </collision>
    <visual name="visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.03" />
      </geometry>
    </visual>
  </link>
  <!-- Joints -->
  <joint name="caster_joint" type="continuous">
    <parent link="base_link" />
    <child link="caster_link" />
    <origin xyz="0.08 0 -0.075" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.0" friction="0.0" />
  </joint>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="-0.07 0.075 -0.05" rpy="-1.5708 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="10000.0" velocity="10.0" />
    <dynamics damping="0.10" friction="0.0" />
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="-0.07 -0.075 -0.05" rpy="-1.5708 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="10000.0" velocity="10.0" />
    <dynamics damping="0.10" friction="0.0" />
  </joint>
  <!-- ============================================================ -->
  <!-- Exercício 1.1 - Representação visual dos sensores            -->
  <!-- Eixos do robô: +X frente, +Y esquerda, +Z cima.            -->
  <!-- ============================================================ -->
  <!-- IMU: pequena caixa sobre o chassi. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.005" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <geometry>
        <box size="0.025 0.025 0.015" />
      </geometry>
      <material name="imu_blue">
        <color rgba="0.1 0.3 0.9 1" />
      </material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="-0.045 0.037 0.060" rpy="0 0 0" />
  </joint>
  <!-- GPS: antena cilíndrica no topo do chassi. -->
  <link name="gps_link">
    <inertial>
      <mass value="0.005" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.015" length="0.012" />
      </geometry>
      <material name="gps_green">
        <color rgba="0.1 0.8 0.2 1" />
      </material>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="-0.045 -0.037 0.060" rpy="0 0 0" />
  </joint>
  <!-- Câmera frontal: +X é o sentido de visão do sensor Gazebo. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.005" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <geometry>
        <box size="0.030 0.040 0.025" />
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.120 0 0.020" rpy="0 0 0" />
  </joint>
  <!-- Quadro óptico ROS: Z frontal, X direita, Y baixo. -->
  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0.015 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <!-- LiDAR frontal com varredura de 180 graus no plano XY. -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.005" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.025" length="0.020" />
      </geometry>
      <material name="lidar_orange">
        <color rgba="0.95 0.4 0.05 1" />
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.075 0 0.075" rpy="0 0 0" />
  </joint>
  <!-- ROS 2 Control Interfaces -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <!-- Friction -->
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="left_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
  </gazebo>

  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="gps_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <!-- IMU -->
  <gazebo reference="imu_link">
    <material>Gazebo/Blue</material>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.002</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.002</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.002</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_ros_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <material>Gazebo/Green</material>
  </gazebo>
  <!-- Câmera RGB -->
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="front_rgb_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="front_rgb_ros_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- LiDAR 2D-->
  <gazebo reference="lidar_link">
    <material>Gazebo/Orange</material>
    <sensor name="front_lidar_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>361</samples>
            <resolution>1</resolution>
            <min_angle>-1.57079632679</min_angle>
            <max_angle>1.57079632679</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_ros_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/lidar/points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="gps_position_sensor" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=/gps/odom_raw</remapping>
      </ros>
      <body_name>gps_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>10</update_rate>
      <gaussian_noise>0.35</gaussian_noise>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>/home/pedro/ci_robotica_ws/src/model_description/params/controllers.yaml</parameters>
      <ros>
        <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
        <remapping>/diff_drive_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="debug_ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=/debug/ground_truth</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>30</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>
</robot>
